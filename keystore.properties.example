# ============================================================================
# FuMiVoice 发布签名配置模板
# ============================================================================
#
# 用法：
#   1. 把本文件复制为仓库根目录的 keystore.properties（已被 .gitignore 忽略）
#   2. 把 .jks 放到 keystore/ 下（同样被 .gitignore 忽略）
#   3. 填好下面四项，再跑 ./gradlew :app:assembleRelease
#
# 注意：
#   · storeFile 相对**仓库根目录**解析，不是相对 app/，也不是绝对路径；
#   · 口令里如果有 : # ! 等字符，properties 文件里按原样写即可（不需要转义）；
#   · 本文件缺失时 release 仍然能构建，只是产出未签名包（assembleRelease 会警告）；
#   · 绝对不要把真正的 keystore.properties / *.jks 提交进仓库。
#
# 签名方案由 app/build.gradle.kts 决定：V1 + V2 + V3 全开。
# 1.0.6 起更换过密钥，1.0.5 及更早版本无法覆盖安装，升级前需先卸载。
# ----------------------------------------------------------------------------

storeFile=keystore/fumivoice-release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=fumivoice
keyPassword=REPLACE_WITH_KEY_PASSWORD
